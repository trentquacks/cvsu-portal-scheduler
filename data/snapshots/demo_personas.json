      "date_posted": "September 10, 2026",
      "content": "All bonafide students enrolled for First Semester AY 2026-2027 may claim or validate their University Identification Cards at the Office of Student Affairs and Services (OSAS), Monday to Friday, 8:00 AM to 5:00 PM. Please bring your printed Registration Form."
    },
    {
      "id": 115,
      "title": "Procedure for Adding, Dropping and Changing of Subject or Schedule (First Semester 2026-2027)",
      "date_posted": "August 17, 2026",
      "content": "Irregular students requesting subject addition, dropping, or section changes are advised to use the Pre-Registration AI Enrollment Scheduler module prior to securing advising sign-off from their Department Registration Adviser."
    },
    {
      "id": 112,
      "title": "Schedule of Enrollment for First Semester 2026-2027",
      "date_posted": "July 09, 2026",
      "content": "Enrollment for Regular and Irregular BSCS students for AY 2026-2027 First Semester will run according to the official Registrar calendar. Irregular students must ensure prerequisite compliance and zero timetable overlap before final assessment."
    },
    {
      "id": 111,
      "title": "Schedule of Enrollment for Midyear Semester 2025-2026",
      "date_posted": "June 12, 2026",
      "content": "Midyear enrollment and practicum pre-assessment schedules have been posted by the Department of Computer Studies. Check your Curriculum Checklist to verify remaining prerequisite subjects."
    },
    {
      "id": 110,
      "title": "Admission Result and Registration Procedure for Academic Year 2026-2027 First Semester",
      "date_posted": "June 12, 2026",
      "content": "Newly admitted freshmen, transferees, and shiftees must submit their credited transcript records to the Office of the Registrar for curriculum evaluation prior to pre-registration."
    },
    {
      "id": 109,
      "title": "Department of Computer Studies Advising Guidelines for Irregular Students",
      "date_posted": "June 05, 2026",
      "content": "Irregular BSCS students may now encode their weekly availability (Monday to Saturday, 7:00 AM to 8:00 PM) inside Pre-Registration to generate conflict-free master schedules and section-swap recommendations."
    }
